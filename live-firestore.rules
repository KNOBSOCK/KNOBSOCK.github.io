rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['FMOSByXnljTHYirhcsJp7DAK4sQ2', 'y1xhfXeUWzfCLm9CCeCIXur98dm1']
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.admin2faUntil is number
        && request.auth.token.admin2faUntil > request.time.toMillis();
    }

    match /chat_config/liveVideo {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chat_config/vods {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chat_config/pastStreamsArchived {
      allow read, write: if isAdmin();
    }
  }
}
