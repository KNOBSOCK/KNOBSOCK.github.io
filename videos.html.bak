&#34;type&#34;:&#34;color&#34;},&#34;background&#34;:{&#34;fill&#34;:{&#34;color&#34;:{&#34;red&#34;:0,&#34;alpha&#34;:0,&#34;green&#34;:0,&#34;blue&#34;:0},&#34;type&#34;:&#34;color&#34;}}}},&#34;iconButton&#34;:{&#34;secondary&#34;:{&#34;background&#34;:{&#34;fill&#34;:{&#34;color&#34;:{&#34;red&#34;:0,&#34;blue&#34;:0,&#34;alpha&#34;:1,&#34;green&#34;:0},&#34;type&#34;:&#34;color&#34;}},&#34;contentBackground&#34;:{&#34;fill&#34;:{&#34;type&#34;:&#34;color&#34;,&#34;color&#34;:{&#34;red&#34;:255,&#34;blue&#34;:255,&#34;alpha&#34;:1,&#34;green&#34;:255}}}},&#34;primary&#34;:{&#34;background&#34;:{&#34;fill&#34;:{&#34;type&#34;:&#34;color&#34;,&#34;color&#34;:{&#34;green&#34;:0,&#34;blue&#34;:0,&#34;red&#34;:0,&#34;alpha&#34;:0}}},&#34;contentBackground&#34;:{&#34;fill&#34;:{&#34;color&#34;:{&#34;blue&#34;:0,&#34;green&#34;:0,&#34;alpha&#34;:1,&#34;red&#34;:0},&#34;type&#34;:&#34;color&#34;}}}},&#34;button&#34;:{&#34;secondary&#34;:{&#34;textFill&#34;:{&#34;type&#34;:&#34;color&#34;,&#34;color&#34;:{&#34;blue&#34;:0,&#34;green&#34;:0,&#34;alpha&#34;:1,&#34;red&#34;:0}},&#34;background&#34;:{&#34;fill&#34;:{&#34;type&#34;:&#34;color&#34;,&#34;color&#34;:{&#34;blue&#34;:0,&#34;alpha&#34;:0,&#34;red&#34;:0,&#34;green&#34;:0}}},&#34;border&#34;:{&#34;width&#34;:2,&#34;data&#34;:{&#34;left&#34;:{&#34;color&#34;:{&#34;green&#34;:0,&#34;red&#34;:0,&#34;alpha&#34;:1,&#34;blue&#34;:0},&#34;style&#34;:&#34;solid&#34;},&#34;right&#34;:{&#34;color&#34;:{&#34;green&#34;:0,&#34;blue&#34;:0,&#34;alpha&#34;:1,&#34;red&#34;:0},&#34;style&#34;:&#34;solid&#34;},&#34;top&#34;:{&#34;style&#34;:&#34;solid&#34;,&#34;color&#34;:{&#34;alpha&#34;:1,&#34;blue&#34;:0,&#34;green&#34;:0,&#34;red&#34;:0}},&#34;type&#34;:&#34;color&#34;,&#34;bottom&#34;:{&#34;color&#34;:{&#34;green&#34;:0,&#34;alpha&#34;:1,&#34;red&#34;:0,&#34;blue&#34;:0},&#34;style&#34;:&#34;solid&#34;}}},&#34;fontSize&#34;:16,&#34;animations&#34;:[],&#34;font&#34;:&#34;HelveticaNeueLTStd-Roman&#34;},&#34;minimal&#34;:{&#34;fontSize&#34;:16,&#34;font&#34;:&#34;HelveticaNeueLTStd-Roman&#34;,&#34;textFill&#34;:{&#34;color&#34;:{&#34;blue&#34;:0,&#34;green&#34;:0,&#34;red&#34;:0,&#34;alpha&#34;:1},&#34;type&#34;:&#34;color&#34;},&#34;animations&#34;:[],&#34;border&#34;:{&#34;width&#34;:2,&#34;data&#34;:{&#34;left&#34;:{&#34;style&#34;:&#34;solid&#34;,&#34;color&#34;:{&#34;alpha&#34;:1,&#34;blue&#34;:0,&#34;green&#34;:0,&#34;red&#34;:0}},&#34;type&#34;:&#34;color&#34;,&#34;top&#34;:{&#34;style&#34;:&#34;solid&#34;,&#34;color&#34;:{&#34;green&#34;:0,&#34;blue&#34;:0,&#34;alpha&#34;:1,&#34;red&#34;:0}},&#34;right&#34;:{&#34;style&#34;:&#34;solid&#34;,&#34;color&#34;:{&#34;blue&#34;:0,&#34;red&#34;:0,&#34;alpha&#34;:1,&#34;green&#34;:0}},&#34;bottom&#34;:{&#34;style&#34;:&#34;solid&#34;,&#34;color&#34;:{&#34;alpha&#34;:1,&#34;blue&#34;:0,&#34;green&#34;:0,&#34;red&#34;:0}}}},&#34;background&#34;:{&#34;fill&#34;:{&#34;color&#34;:{&#34;alpha&#34;:0,&#34;blue&#34;:0,&#34;green&#34;:0,&#34;red&#34;:0},&#34;type&#34;:&#34;color&#34;}}},&#34;primary&#34;:{&#34;fontSize&#34;:24,&#34;font&#34;:&#34;HelveticaNeueLTStd-Roman&#34;,&#34;textFill&#34;:{&#34;color&#34;:{&#34;green&#34;:255,&#34;red&#34;:255,&#34;alpha&#34;:1,&#34;blue&#34;:255},&#34;type&#34;:&#34;color&#34;},&#34;animations&#34;:[],&#34;background&#34;:{&#34;fill&#34;:{&#34;color&#34;:{&#34;green&#34;:0,&#34;alpha&#34;:1,&#34;red&#34;:0,&#34;blue&#34;:0},&#34;type&#34;:&#34;color&#34;}}},&#34;tertiary&#34;:{&#34;textFill&#34;:{&#34;color&#34;:{&#34;blue&#34;:255,&#34;red&#34;:255,&#34;green&#34;:255,&#34;alpha&#34;:1},&#34;type&#34;:&#34;color&#34;},&#34;animations&#34;:[],&#34;font&#34;:&#34;HelveticaNeueLTStd-Roman&#34;,&#34;fontSize&#34;:24,&#34;background&#34;:{&#34;fill&#34;:{&#34;type&#34;:&#34;color&#34;,&#34;color&#34;:{&#34;blue&#34;:0,&#34;alpha&#34;:1,&#34;red&#34;:0,&#34;green&#34;:0}}}}}},&#34;id&#34;:&#34;thm_01m0m5njf3e298vk1fy6eg4dyd&#34;},&#34;contentType&#34;:&#34;document&#34;,&#34;favicon&#34;:&#34;universelogo&#34;,&#34;siteId&#34;:2476929,&#34;faviconAssetId&#34;:&#34;e90abc0a-d3ae-408c-bdcc-c7aa53c49f02&#34;,&#34;siteTitle&#34;:&#34;KNOBSOCK&#34;,&#34;pageTitle&#34;:&#34;Videos&#34;,&#34;shouldShowBanner&#34;:false,&#34;siteDescription&#34;:&#34;Official Website for Knobsock&#34;,&#34;isPro&#34;:true,&#34;metaTags&#34;:[],&#34;isHomepage&#34;:false,&#34;snapshotUuid&#34;:&#34;15ff6603-8a99-42dc-a14f-e7e1fafb2dec&#34;,&#34;activeSubpageIndex&#34;:0,&#34;content&#34;:{&#34;snapshotUUID&#34;:&#34;15ff6603-8a99-42dc-a14f-e7e1fafb2dec&#34;,&#34;background&#34;:{&#34;asset&#34;:{&#34;data&#34;:{&#34;url&#34;:&#34;https://onuniverse-assets.imgix.net/066FFB53-0FD0-4166-80B1-0EF9B4BDBC57.mp4&#34;,&#34;loadingImageUrl&#34;:&#34;/_assets/797DD636-6296-4526-9CA7-C78794338FAA?px=10\u0026w=200\u0026q=1&#34;,&#34;type&#34;:&#34;video&#34;},&#34;contentMode&#34;:{&#34;type&#34;:&#34;fill&#34;}},&#34;fill&#34;:{&#34;color&#34;:{&#34;green&#34;:255,&#34;red&#34;:255,&#34;alpha&#34;:1,&#34;blue&#34;:255},&#34;type&#34;:&#34;color&#34;}},&#34;contentType&#34;:&#34;section&#34;,&#34;slug&#34;:&#34;videos&#34;,&#34;id&#34;:8807491,&#34;content&#34;:{&#34;background&#34;:&#34;none&#34;,&#34;contentType&#34;:&#34;block&#34;,&#34;themeStyle&#34;:&#34;primary&#34;,&#34;content&#34;:{&#34;isRoot&#34;:true,&#34;gridSize&#34;:{&#34;height&#34;:17,&#34;width&#34;:8},&#34;contentType&#34;:&#34;flexGrid&#34;,&#34;children&#34;:[{&#34;position&#34;:{&#34;z&#34;:0,&#34;y&#34;:0,&#34;x&#34;:1},&#34;block&#34;:{&#34;margins&#34;:{&#34;right&#34;:{&#34;flexible&#34;:false},&#34;left&#34;:{&#34;flexible&#34;:false},&#34;top&#34;:{&#34;flexible&#34;:true}},&#34;id&#34;:&#34;39857DDA-9D62-4194-9FEE-BCAA1F680284&#34;,&#34;contentType&#34;:&#34;block&#34;,&#34;themeCategory&#34;:&#34;image&#34;,&#34;themeStyle&#34;:&#34;primary&#34;,&#34;actions&#34;:{&#34;tap&#34;:[{&#34;destination&#34;:&#34;/main&#34;,&#34;type&#34;:&#34;linkToWeb&#34;}]},&#34;content&#34;:{&#34;contentType&#34;:&#34;image&#34;,&#34;unscaledBlockSize&#34;:{&#34;width&#34;:1000,&#34;height&#34;:81},&#34;contentMode&#34;:&#34;aspectFit&#34;,&#34;contentHeight&#34;:{&#34;value&#34;:81,&#34;type&#34;:&#34;constant&#34;},&#34;imageAspectRatio&#34;:3.3415233415233416,&#34;position&#34;:{&#34;x&#34;:50,&#34;y&#34;:100},&#34;picture&#34;:{&#34;variations&#34;:{&#34;default&#34;:[{&#34;url&#34;:&#34;/_assets/AD561A27-0A0A-4278-B46C-7B2CA315F8BA?q=60\u0026w=200\u0026auto=compress,format\u0026fit=clip&#34;,&#34;height&#34;:59,&#34;width&#34;:200},{&#34;url&#34;:&#34;/_assets/AD561A27-0A0A-4278-B46C-7B2CA315F8BA?q=60\u0026w=375\u0026auto=compress,format\u0026fit=clip&#34;,&#34;height&#34;:112,&#34;width&#34;:375},{&#34;url&#34;:&#34;/_assets/AD561A27-0A0A-4278-B46C-7B2CA315F8BA?q=60\u0026w=750\u0026auto=compress,format\u0026fit=clip&#34;,&#34;width&#34;:750,&#34;height&#34;:224},{&#34;url&#34;:&#34;/_assets/AD561A27-0A0A-4278-B46C-7B2CA315F8BA?q=60\u0026w=1500\u0026auto=compress,format\u0026fit=clip&#34;,&#34;width&#34;:1500,&#34;height&#34;:448},{&#34;url&#34;:&#34;/_assets/AD561A27-0A0A-4278-B46C-7B2CA315F8BA?q=60\u0026w=2250\u0026auto=compress,format\u0026fit=clip&#34;,&#34;width&#34;:2250,&#34;height&#34;:673}]},&#34;imageUrl&#34;:&#34;/_assets/AD561A27-0A0A-4278-B46C-7B2CA315F8BA?q=65\u0026w=200\u0026auto=compress,format\u0026fit=clip&#34;,&#34;fullSizeImageUrl&#34;:&#34;/_assets/AD561A27-0A0A-4278-B46C-7B2CA315F8BA?w=1.0&#34;},&#34;originalSize&#34;:{&#34;width&#34;:4080,&#34;height&#34;:1221}}},&#34;size&#34;:{&#34;width&#34;:6,&#34;height&#34;:1}},{&#34;position&#34;:{&#34;x&#34;:0,&#34;z&#34;:1,&#34;y&#34;:1},&#34;block&#34;:{&#34;id&#34;:&#34;C97F7EFB-C54F-4777-B87B-229EEB2D5F5B&#34;,&#34;actions&#34;:{},&#34;content&#34;:{&#34;contentType&#34;:&#34;code&#34;,&#34;contentHeight&#34;:{&#34;type&#34;:&#34;auto&#34;},&#34;code&#34;:&#34;\u003c!DOCTYPE html\u003e\n\u003chtml lang=\&#34;en\&#34;\u003e\n\u003chead\u003e\n\u003cmeta charset=\&#34;UTF-8\&#34;\u003e\n\u003cmeta name=\&#34;viewport\&#34; content=\&#34;width=device-width, initial-scale=1, maximum-scale=1\&#34;\u003e\n\u003ctitle\u003eVideo Player + Playlist\u003c/title\u003e\n\u003cstyle\u003e\n  :root {\n    --ink: #0a2a4a;\n    --panel: rgba(10, 42, 74, 0.32);\n    --panel-2: rgba(10, 42, 74, 0.8);\n    --line: rgba(150, 200, 255, 0.6);\n    --accent: #2f80ed;\n    --accent-dim: #1c4e8a;\n    --accent-yellow: #ffdd00;\n    --text: #ffffff;\n    --text-dim: #c9dcf5;\n    --font-display: Arial, Helvetica, sans-serif;\n    --font-body: Arial, Helvetica, sans-serif;\n  }\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    background: transparent;\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    padding: 0;\n    overflow: hidden;\n  }\n\n  body { position: relative; }\n\n  /* ---------- BACKDROP ----------\n     A padded, rounded panel with a 50% frosted backdrop blur — same blur\n     treatment as the truth zone page&#39;s card (our 1-100 scale: 100% = 20px,\n     so 50% = 10px). It&#39;s a sibling of .layout (not nested inside it), so\n     its width is capped/centered the same way .layout is — otherwise on a\n     big monitor the glow panel would keep stretching edge-to-edge even\n     after the content inside .layout got capped at 1200px. */\n  .bg-glow {\n    position: absolute;\n    top: clamp(16px, 3vw, 32px);\n    bottom: clamp(16px, 3vw, 32px);\n    left: 50%;\n    transform: translateX(-50%);\n    width: min(calc(100% - clamp(32px, 6vw, 64px)), calc(1200px - clamp(32px, 6vw, 64px)));\n    border-radius: clamp(10px, 2.5vw, 28px);\n    background: rgba(47, 128, 237, 0.45);\n    backdrop-filter: blur(10px) saturate(150%);\n    -webkit-backdrop-filter: blur(10px) saturate(150%);\n    z-index: -1;\n    pointer-events: none;\n  }\n\n  /* ---------- PAGE LAYOUT ----------\n     Desktop: big player + playlist side by side, with the creator chin\n     (below) as a fixed-height strip under both. Mobile (\u003c= 860px wide):\n     player on top, playlist scrolls below — same breakpoint and stacking\n     pattern as the livestream widget; the chin stays pinned to the\n     bottom either way since it&#39;s a sibling of .main-row inside .layout,\n     not part of the row that flips direction. */\n  .layout {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    height: 100%;\n    /* Capped so the player doesn&#39;t stretch edge-to-edge on a big monitor —\n       centered within the full-bleed background glow behind it instead. */\n    max-width: 1200px;\n    margin: 0 auto;\n    gap: 10px;\n    padding: clamp(18px, 3.5vw, 36px);\n    background: transparent;\n  }\n\n  .main-row {\n    display: flex;\n    flex-direction: row;\n    flex: 1 1 auto;\n    min-height: 0;\n    gap: 14px;\n  }\n\n  .video-pane {\n    position: relative;\n    overflow: hidden;\n    background: #000;\n    border-radius: 10px;\n    flex: 1 1 66%;\n    container-type: size;\n    container-name: videobox;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .video-frame-wrap {\n    width: min(100cqw, calc(100cqh * 16 / 9));\n    height: min(100cqh, calc(100cqw * 9 / 16));\n  }\n\n  .video-frame-wrap iframe {\n    display: block;\n    width: 100%;\n    height: 100%;\n    border: 0;\n  }\n\n  .playlist-pane {\n    flex: 1 1 34%;\n    min-width: 280px;\n    display: flex;\n    container-type: size;\n    container-name: playlistbox;\n  }\n\n  @media (max-width: 860px) {\n    .main-row { flex-direction: column; }\n    .video-pane { flex: 0 0 38vh; }\n    .playlist-pane { flex: 1 1 auto; min-width: 0; }\n  }\n\n  .layout.playlist-hidden .playlist-pane { display: none; }\n  .layout.playlist-hidden .video-pane { flex: 1 1 100%; }\n\n  /* ---------- CREATOR CHIN ----------\n     A row of pill buttons across the bottom, one per creator seen in the\n     playlist (plus \&#34;All\&#34;). Auto-populated as each video&#39;s author comes\n     back from the oEmbed fetch below — clicking one filters the same\n     \&#34;Up Next\&#34; list to just that creator&#39;s videos, it doesn&#39;t touch\n     what&#39;s currently playing. */\n  .creator-chin {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    gap: clamp(6px, 1.5vw, 10px);\n    padding: 2px;\n    overflow-x: auto;\n    overflow-y: hidden;\n    /* Scrolling (swipe/drag/shift+wheel) still works when there are more\n       chips than fit — this just hides the visible scrollbar itself, on\n       every device, not just phones. */\n    scrollbar-width: none; /* Firefox */\n    -ms-overflow-style: none; /* old Edge/IE */\n  }\n  .creator-chin::-webkit-scrollbar { display: none; } /* Chrome/Safari/new Edge */\n\n  .creator-chip {\n    flex: none;\n    -webkit-appearance: none;\n    appearance: none;\n    cursor: pointer;\n    font-family: var(--font-body);\n    font-weight: 700;\n    border-radius: 999px;\n    padding: clamp(6px, 1.6vw, 9px) clamp(14px, 3vw, 18px);\n    font-size: clamp(11px, 2.6vw, 13px);\n    white-space: nowrap;\n    background: var(--panel-2);\n    border: 1px solid var(--line);\n    color: var(--text);\n  }\n  .creator-chip:hover { background: var(--accent-dim); }\n  .creator-chip.active {\n    /* The selected chip (including \&#34;All\&#34;) stands out in yellow while\n       everything else on the page stays blue — text flips to the dark\n       ink color here since white-on-yellow doesn&#39;t read well. */\n    background: var(--accent-yellow);\n    border-color: var(--accent-yellow);\n    color: var(--ink);\n  }\n\n  .pill-btn {\n    -webkit-appearance: none;\n    appearance: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    font-family: var(--font-body);\n    font-weight: 700;\n    line-height: 1;\n    border-radius: clamp(4px, 1.5cqw, 8px);\n    padding: clamp(6px, 1.8cqh, 10px) clamp(12px, 3.4cqw, 18px);\n    font-size: clamp(11px, 3cqw, 14px);\n    white-space: nowrap;\n    background: var(--accent);\n    border: 1px solid var(--accent-dim);\n    color: #ffffff;\n  }\n  .pill-btn:hover:not(:disabled) { background: var(--accent-dim); }\n  .pill-btn:active:not(:disabled) { background: var(--accent-dim); }\n  .pill-btn:disabled { opacity: 0.5; cursor: default; }\n\n  .video-pane-actions {\n    position: absolute;\n    top: clamp(8px, 2cqh, 14px);\n    right: clamp(8px, 2cqw, 14px);\n    z-index: 5;\n    display: flex;\n    gap: clamp(6px, 1.5cqw, 10px);\n  }\n\n  .unmute-btn {\n    position: absolute;\n    top: clamp(8px, 2cqh, 14px);\n    left: clamp(8px, 2cqw, 14px);\n    z-index: 5;\n  }\n\n  .video-pane .unmute-btn,\n  .video-pane .video-pane-actions,\n  .video-pane .video-controls {\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.25s ease;\n  }\n  .video-pane:hover .unmute-btn,\n  .video-pane:hover .video-pane-actions,\n  .video-pane:hover .video-controls,\n  .video-pane:focus-within .unmute-btn,\n  .video-pane:focus-within .video-pane-actions,\n  .video-pane:focus-within .video-controls {\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  /* ---------- CUSTOM VIDEO PLAYBACK CONTROLS ---------- */\n  .video-controls {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 6;\n    display: flex;\n    align-items: center;\n    gap: clamp(8px, 2cqw, 12px);\n    padding: clamp(10px, 2.6cqh, 14px) clamp(10px, 3cqw, 16px);\n    background: linear-gradient(to top, rgba(2, 62, 138, 0.85), rgba(2, 62, 138, 0));\n  }\n\n  .round-btn {\n    -webkit-appearance: none;\n    appearance: none;\n    border-radius: 50%;\n    aspect-ratio: 1 / 1;\n    padding: 0;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    font-family: var(--font-body);\n    font-weight: 700;\n    line-height: 1;\n    background: var(--accent);\n    border: 1px solid var(--line);\n    color: #ffffff;\n  }\n  .round-btn:hover:not(:disabled) { background: var(--accent-dim); }\n  .round-btn:active:not(:disabled) { background: var(--accent-dim); }\n  .round-btn:disabled { opacity: 0.5; cursor: default; }\n\n  .play-pause-btn {\n    width: clamp(26px, 7.5cqw, 34px);\n    font-size: clamp(11px, 3.2cqw, 15px);\n    flex: none;\n  }\n\n  .fullscreen-btn {\n    width: clamp(26px, 7.5cqw, 34px);\n    font-size: clamp(11px, 3.2cqw, 15px);\n    flex: none;\n  }\n\n  .video-pane.pseudo-fullscreen {\n    position: fixed;\n    top: 0; left: 0; right: 0; bottom: 0;\n    width: 100vw; height: 100vh; height: 100dvh;\n    margin: 0;\n    border-radius: 0;\n    z-index: 9999;\n  }\n\n  .scrub-range {\n    flex: 1 1 auto;\n    -webkit-appearance: none;\n    appearance: none;\n    height: 4px;\n    border-radius: 2px;\n    background: var(--accent-dim);\n    outline: none;\n    cursor: pointer;\n    min-width: 0;\n  }\n  .scrub-range:disabled { opacity: 0.5; cursor: default; }\n  .scrub-range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: transparent; }\n  .scrub-range::-webkit-slider-thumb {\n    -webkit-appearance: none; appearance: none;\n    width: 13px; height: 13px; margin-top: -4.5px;\n    border-radius: 50%; background: var(--accent);\n    border: 2px solid #ffffff; cursor: pointer;\n  }\n  .scrub-range::-moz-range-track { height: 4px; border-radius: 2px; background: var(--accent-dim); }\n  .scrub-range::-moz-range-progress { height: 4px; border-radius: 2px; background: var(--accent); }\n  .scrub-range::-moz-range-thumb {\n    width: 13px; height: 13px; border-radius: 50%;\n    background: var(--accent); border: 2px solid #ffffff; cursor: pointer;\n  }\n\n  .time-label {\n    flex: none;\n    font-size: clamp(9px, 2.6cqw, 12px);\n    color: var(--text-dim);\n    font-family: var(--font-body);\n    white-space: nowrap;\n  }\n\n  /* ---------- PLAYLIST WIDGET ---------- */\n  .playlist-card {\n    width: 100%;\n    height: 100%;\n    background: transparent;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    font-family: var(--font-body);\n    color: var(--text);\n  }\n\n  .playlist-header {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: clamp(8px, 2.6cqh, 12px) clamp(10px, 3cqw, 14px);\n    border-bottom: 1px solid var(--line);\n  }\n\n  .playlist-title {\n    font-size: clamp(12px, 3.2cqw, 15px);\n    font-weight: 700;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    color: var(--accent);\n  }\n\n  .playlist-count {\n    font-size: clamp(9px, 2.6cqw, 12px);\n    color: var(--text-dim);\n  }\n\n  .playlist-items {\n    flex: 1 1 auto;\n    min-height: 0;\n    overflow-y: auto;\n    padding: clamp(8px, 2.4cqh, 12px);\n    display: flex;\n    flex-direction: column;\n    gap: clamp(6px, 2cqh, 10px);\n  }\n  .playlist-items::-webkit-scrollbar { width: 8px; }\n  .playlist-items::-webkit-scrollbar-track { background: transparent; }\n  .playlist-items::-webkit-scrollbar-thumb { background: var(--accent-dim); border-radius: 4px; }\n\n  @media (max-width: 860px) {\n    .playlist-items { flex-direction: row; overflow-x: auto; overflow-y: hidden; }\n  }\n\n  .playlist-item {\n    display: flex;\n    align-items: center;\n    gap: clamp(8px, 2.4cqw, 12px);\n    background: var(--panel-2);\n    border: 1px solid var(--line);\n    border-radius: clamp(6px, 2cqw, 10px);\n    padding: clamp(6px, 1.8cqh, 8px);\n    cursor: pointer;\n    text-align: left;\n    color: var(--text);\n    font-family: var(--font-body);\n    flex: none;\n  }\n  .playlist-item:hover { background: var(--accent-dim); }\n  .playlist-item.active {\n    /* Highlighted in yellow (matching the creator chin&#39;s active chip)\n       instead of blue, so the selected video stands out from the rest\n       of the blue UI the same way the active creator filter does. Kept\n       as a translucent wash rather than a solid fill so the white title\n       text stays legible over it. */\n    background: rgba(255, 221, 0, 0.18);\n    border-color: var(--accent-yellow);\n    box-shadow: 0 0 8px rgba(255, 221, 0, 0.5);\n  }\n\n  @media (max-width: 860px) {\n    .playlist-item { width: clamp(160px, 42vw, 220px); flex-direction: column; align-items: stretch; }\n  }\n\n  .playlist-thumb-wrap {\n    position: relative;\n    flex: none;\n    width: clamp(72px, 24cqw, 108px);\n    aspect-ratio: 16 / 9;\n    border-radius: clamp(4px, 1cqw, 6px);\n    overflow: hidden;\n    background: #000;\n  }\n  @media (max-width: 860px) {\n    .playlist-thumb-wrap { width: 100%; }\n  }\n  .playlist-thumb-wrap img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .playlist-item.active .playlist-thumb-wrap::after {\n    content: \&#34;\&#34;;\n    position: absolute;\n    inset: 0;\n    border: 2px solid var(--accent-yellow);\n    border-radius: inherit;\n  }\n  .now-playing-badge {\n    position: absolute;\n    left: 4px;\n    bottom: 4px;\n    background: rgba(10, 58, 10, 0.85);\n    color: var(--accent-yellow);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    padding: 2px 5px;\n    border-radius: 3px;\n    display: none;\n  }\n  .playlist-item.active .now-playing-badge { display: inline-block; }\n\n  .playlist-meta {\n    min-width: 0;\n    flex: 1 1 auto;\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n  }\n  .playlist-item-title {\n    font-size: clamp(11px, 2.8cqw, 13px);\n    font-weight: 700;\n    line-height: 1.3;\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n  }\n  .playlist-item-sub {\n    font-size: clamp(9px, 2.4cqw, 11px);\n    color: var(--text-dim);\n  }\n\n  .empty-state {\n    margin: auto;\n    text-align: center;\n    color: var(--text-dim);\n    font-size: clamp(10px, 2.8cqw, 13px);\n    padding: 20px;\n  }\n\n  /* ---------- HIDDEN ADMIN TRIGGER ----------\n     A near-invisible dot tucked in the corner. It&#39;s technically always\n     there and clickable, but at ~4% opacity against a dark page it\n     doesn&#39;t read as a UI element to a casual visitor. A keyboard\n     shortcut (Ctrl+Alt+A) opens the same login without needing to\n     find it at all. Note: with Firebase Auth + Firestore rules doing\n     the real access control, this trigger is just a convenience for\n     you, not a security boundary. */\n  .admin-trigger {\n    position: absolute;\n    right: 6px;\n    bottom: 6px;\n    width: 14px;\n    height: 14px;\n    border-radius: 50%;\n    background: #888;\n    border: none;\n    padding: 0;\n    opacity: 0.04;\n    cursor: default;\n    z-index: 50;\n    transition: opacity 0.2s ease;\n  }\n  .admin-trigger:hover,\n  .admin-trigger:focus-visible {\n    opacity: 0.35;\n    cursor: pointer;\n  }\n\n  /* ---------- ADMIN OVERLAYS ---------- */\n  .admin-overlay {\n    position: absolute;\n    inset: 0;\n    z-index: 100;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: rgba(4, 14, 26, 0.72);\n    padding: 16px;\n    font-family: var(--font-body);\n    color: var(--text);\n  }\n  .admin-overlay[hidden] { display: none; }\n\n  .admin-modal {\n    position: relative;\n    width: 100%;\n    max-width: 320px;\n    background: var(--ink);\n    border: 1px solid var(--line);\n    border-radius: 12px;\n    padding: 22px 20px 20px;\n    box-shadow: 0 0 30px rgba(47, 128, 237, 0.35);\n  }\n\n  .admin-panel {\n    position: relative;\n    width: 100%;\n    max-width: 560px;\n    max-height: 86vh;\n    background: var(--ink);\n    border: 1px solid var(--line);\n    border-radius: 12px;\n    padding: 20px;\n    box-shadow: 0 0 30px rgba(47, 128, 237, 0.35);\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    overflow: hidden;\n  }\n\n  .admin-modal h2,\n  .admin-panel-header h2 {\n    margin: 0 0 4px;\n    font-size: 16px;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    color: var(--accent);\n  }\n\n  .admin-panel-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    flex: 0 0 auto;\n  }\n\n  .admin-close,\n  .admin-panel-close {\n    width: 28px;\n    height: 28px;\n    flex: none;\n  }\n\n  .admin-modal label,\n  .admin-row label {\n    display: block;\n    font-size: 11px;\n    color: var(--text-dim);\n    margin: 12px 0 5px;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n  }\n\n  .admin-modal input[type=\&#34;text\&#34;],\n  .admin-modal input[type=\&#34;email\&#34;],\n  .admin-modal input[type=\&#34;password\&#34;],\n  .admin-row input[type=\&#34;text\&#34;] {\n    width: 100%;\n    padding: 9px 10px;\n    background: rgba(0, 0, 0, 0.35);\n    border: 1px solid var(--line);\n    border-radius: 4px;\n    color: var(--text);\n    font-size: 14px;\n    font-family: var(--font-body);\n    outline: none;\n  }\n  .admin-modal input:focus,\n  .admin-row input:focus { border-color: var(--accent); }\n\n  .admin-checkbox-label {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 11px;\n    color: var(--text-dim);\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    margin: 12px 0 0;\n    cursor: pointer;\n  }\n  .admin-checkbox-label input[type=\&#34;checkbox\&#34;] {\n    width: 14px;\n    height: 14px;\n    cursor: pointer;\n  }\n\n  .admin-modal-actions {\n    margin-top: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .admin-error {\n    margin-top: 10px;\n    font-size: 12px;\n    color: #ff9b9b;\n    min-height: 14px;\n  }\n\n  .admin-video-list,\n  .admin-creator-list {\n    flex: 1 1 0;\n    min-height: 110px;\n    overflow-y: auto;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    padding-right: 4px;\n  }\n  .admin-video-list::-webkit-scrollbar,\n  .admin-creator-list::-webkit-scrollbar { width: 8px; }\n  .admin-video-list::-webkit-scrollbar-track,\n  .admin-creator-list::-webkit-scrollbar-track { background: transparent; }\n  .admin-video-list::-webkit-scrollbar-thumb,\n  .admin-creator-list::-webkit-scrollbar-thumb { background: var(--accent-dim); border-radius: 4px; }\n\n  .admin-section-heading {\n    flex: 0 0 auto;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    color: var(--accent);\n    border-top: 1px solid var(--line);\n    padding-top: 10px;\n  }\n\n  .admin-row {\n    background: var(--panel-2);\n    border: 1px solid var(--line);\n    border-radius: 8px;\n    padding: 10px 12px 12px;\n  }\n\n  .admin-row-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n  }\n\n  .admin-row-title {\n    font-size: 11px;\n    color: var(--text-dim);\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n  }\n\n  .admin-row-btns { display: flex; gap: 6px; flex: none; }\n\n  .admin-row-btns .round-btn {\n    width: 24px;\n    font-size: 12px;\n  }\n\n  .admin-panel-footer {\n    flex: 0 0 auto;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    border-top: 1px solid var(--line);\n    padding-top: 12px;\n  }\n\n  .admin-footer-actions { display: flex; gap: 8px; flex-wrap: wrap; }\n\n  .admin-link-btn {\n    background: none;\n    border: none;\n    color: var(--text-dim);\n    font-family: var(--font-body);\n    font-size: 11px;\n    text-decoration: underline;\n    cursor: pointer;\n    padding: 0;\n  }\n  .admin-link-btn:hover { color: var(--text); }\n\n  .admin-save-status {\n    font-size: 12px;\n    color: var(--accent);\n    min-height: 14px;\n  }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n\u003cdiv class=\&#34;bg-glow\&#34; aria-hidden=\&#34;true\&#34;\u003e\u003c/div\u003e\n\u003cdiv class=\&#34;layout\&#34; id=\&#34;layout\&#34;\u003e\n \u003cdiv class=\&#34;main-row\&#34; id=\&#34;mainRow\&#34;\u003e\n  \u003cdiv class=\&#34;video-pane\&#34; id=\&#34;videoPane\&#34;\u003e\n    \u003cbutton class=\&#34;pill-btn unmute-btn\&#34; id=\&#34;unmuteBtn\&#34; title=\&#34;Unmute\&#34;\u003eUnmute\u003c/button\u003e\n    \u003cdiv class=\&#34;video-pane-actions\&#34;\u003e\n      \u003cbutton class=\&#34;pill-btn toggle-playlist-btn\&#34; id=\&#34;togglePlaylistBtn\&#34; title=\&#34;Hide playlist\&#34;\u003eHide Playlist\u003c/button\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\&#34;video-frame-wrap\&#34;\u003e\n      \u003ciframe\n        id=\&#34;ytFrame\&#34;\n        src=\&#34;\&#34;\n        allowfullscreen\n        scrolling=\&#34;no\&#34;\n        allow=\&#34;accelerometer *; autoplay *; clipboard-write *; encrypted-media *; gyroscope *; picture-in-picture *; web-share *;\&#34;\n        referrerpolicy=\&#34;strict-origin\&#34;\n        style=\&#34;pointer-events: none;\&#34;\u003e\n      \u003c/iframe\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\&#34;video-controls\&#34; id=\&#34;videoControls\&#34;\u003e\n      \u003cbutton class=\&#34;round-btn play-pause-btn\&#34; id=\&#34;playPauseBtn\&#34; title=\&#34;Pause\&#34; disabled\u003e\u0026#10074;\u0026#10074;\u003c/button\u003e\n      \u003cinput type=\&#34;range\&#34; class=\&#34;scrub-range\&#34; id=\&#34;scrubRange\&#34; min=\&#34;0\&#34; max=\&#34;100\&#34; step=\&#34;0.1\&#34; value=\&#34;0\&#34; disabled /\u003e\n      \u003cspan class=\&#34;time-label\&#34; id=\&#34;timeLabel\&#34;\u003e0:00 / 0:00\u003c/span\u003e\n      \u003cbutton class=\&#34;round-btn fullscreen-btn\&#34; id=\&#34;fullscreenBtn\&#34; title=\&#34;Fullscreen\&#34;\u003e\u0026#9974;\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\&#34;playlist-pane\&#34; id=\&#34;playlistPane\&#34;\u003e\n    \u003cdiv class=\&#34;playlist-card\&#34;\u003e\n      \u003cdiv class=\&#34;playlist-header\&#34;\u003e\n        \u003cspan class=\&#34;playlist-title\&#34;\u003eUp Next\u003c/span\u003e\n        \u003cspan class=\&#34;playlist-count\&#34; id=\&#34;playlistCount\&#34;\u003e\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\&#34;playlist-items\&#34; id=\&#34;playlistItems\&#34;\u003e\n        \u003cdiv class=\&#34;empty-state\&#34;\u003eLoading playlist…\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n \u003c/div\u003e\n\n  \u003c!-- Auto-populated from each video&#39;s YouTube author — see\n       renderCreatorChin() below. \&#34;All\&#34; chip clears the filter. --\u003e\n  \u003cdiv class=\&#34;creator-chin\&#34; id=\&#34;creatorChin\&#34;\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003c!-- Hidden admin access point — nearly invisible, tucked in the corner.\n     Ctrl+Alt+A opens the same login without needing to find it. --\u003e\n\u003cbutton class=\&#34;admin-trigger\&#34; id=\&#34;adminTrigger\&#34; aria-label=\&#34;Admin\&#34;\u003e\u003c/button\u003e\n\n\u003c!-- Login --\u003e\n\u003cdiv class=\&#34;admin-overlay\&#34; id=\&#34;loginOverlay\&#34; hidden\u003e\n  \u003cdiv class=\&#34;admin-modal\&#34;\u003e\n    \u003cbutton class=\&#34;round-btn admin-close\&#34; id=\&#34;loginClose\&#34; title=\&#34;Close\&#34;\u003e\u0026times;\u003c/button\u003e\n    \u003ch2\u003eAdmin Sign In\u003c/h2\u003e\n    \u003clabel for=\&#34;loginUser\&#34;\u003eEmail\u003c/label\u003e\n    \u003cinput type=\&#34;email\&#34; id=\&#34;loginUser\&#34; autocomplete=\&#34;off\&#34; /\u003e\n    \u003clabel for=\&#34;loginPass\&#34;\u003ePassword\u003c/label\u003e\n    \u003cinput type=\&#34;password\&#34; id=\&#34;loginPass\&#34; autocomplete=\&#34;off\&#34; /\u003e\n    \u003cdiv class=\&#34;admin-modal-actions\&#34;\u003e\n      \u003cbutton class=\&#34;pill-btn\&#34; id=\&#34;loginSubmit\&#34;\u003eSign In\u003c/button\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\&#34;admin-error\&#34; id=\&#34;loginError\&#34;\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003c!-- Admin panel --\u003e\n\u003cdiv class=\&#34;admin-overlay\&#34; id=\&#34;adminOverlay\&#34; hidden\u003e\n  \u003cdiv class=\&#34;admin-panel\&#34;\u003e\n    \u003cdiv class=\&#34;admin-panel-header\&#34;\u003e\n      \u003ch2\u003eManage Videos\u003c/h2\u003e\n      \u003cbutton class=\&#34;round-btn admin-panel-close\&#34; id=\&#34;adminPanelClose\&#34; title=\&#34;Close\&#34;\u003e\u0026times;\u003c/button\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\&#34;admin-video-list\&#34; id=\&#34;adminVideoList\&#34;\u003e\u003c/div\u003e\n    \u003cdiv class=\&#34;admin-section-heading\&#34;\u003eCreators\u003c/div\u003e\n    \u003c!-- One row per creator name detected across the videos above.\n         \&#34;Display As\&#34; lets you rename a creator, and giving two rows the\n         same Display As combines them into a single chip. The up/down\n         arrows set the order the chips appear in; unchecking a video\n         doesn&#39;t remove a creator here — hide them with the checkbox\n         instead. --\u003e\n    \u003cdiv class=\&#34;admin-creator-list\&#34; id=\&#34;adminCreatorList\&#34;\u003e\u003c/div\u003e\n    \u003cdiv class=\&#34;admin-panel-footer\&#34;\u003e\n      \u003cdiv class=\&#34;admin-footer-actions\&#34;\u003e\n        \u003cbutton class=\&#34;pill-btn\&#34; id=\&#34;addVideoBtn\&#34;\u003e+ Add Video\u003c/button\u003e\n        \u003cbutton class=\&#34;pill-btn\&#34; id=\&#34;saveVideosBtn\&#34;\u003eSave Changes\u003c/button\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\&#34;admin-footer-actions\&#34;\u003e\n        \u003cbutton class=\&#34;admin-link-btn\&#34; id=\&#34;resetDefaultBtn\&#34;\u003eReset to default list\u003c/button\u003e\n        \u003cbutton class=\&#34;admin-link-btn\&#34; id=\&#34;logoutBtn\&#34;\u003eSign out\u003c/button\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\&#34;admin-save-status\&#34; id=\&#34;adminSaveStatus\&#34;\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003c!-- ============================================================\n     FIREBASE — reuses the same project/pattern as the livestream chat\n     widget. Fill in firebaseConfig below with your project&#39;s values\n     (Firebase console → Project settings → General → Your apps).\n     ============================================================ --\u003e\n\u003cscript src=\&#34;https://www.gstatic.com/firebasejs/10.13.2/firebase-app-compat.js\&#34;\u003e\u003c/script\u003e\n\u003cscript src=\&#34;https://www.gstatic.com/firebasejs/10.13.2/firebase-auth-compat.js\&#34;\u003e\u003c/script\u003e\n\u003cscript src=\&#34;https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js\&#34;\u003e\u003c/script\u003e\n\u003cscript\u003e\n  const firebaseConfig = {\n    apiKey: \&#34;AIzaSyAPOqBlb2ZegRCAbBqIyHqziJywB453pTM\&#34;,\n    authDomain: \&#34;chat-for-website-efee2.firebaseapp.com\&#34;,\n    projectId: \&#34;chat-for-website-efee2\&#34;,\n    storageBucket: \&#34;chat-for-website-efee2.firebasestorage.app\&#34;,\n    messagingSenderId: \&#34;509309222193\&#34;,\n    appId: \&#34;1:509309222193:web:f487258cfba2f7f7b00410\&#34;\n  };\n  firebase.initializeApp(firebaseConfig);\n  const db = firebase.firestore();\n  const auth = firebase.auth();\n\n  // Firestore document that holds the shared playlist — everyone reads\n  // this live; only a signed-in admin (per your Firestore rules) can write it.\n  const PLAYLIST_DOC_REF = db.collection(&#39;playlist&#39;).doc(&#39;main&#39;);\n\u003c/script\u003e\n\n\u003cscript\u003e\n// ============================================================\n// DEFAULT PLAYLIST — used as a fallback only: before the Firestore\n// document has ever been saved, or if it&#39;s temporarily unreachable.\n// Once you sign in as admin and save changes, the Firestore document\n// becomes the live source of truth for every visitor.\n// ============================================================\nconst DEFAULT_VIDEO_LIST = [\n  { url: \&#34;https://youtube.com/watch?v=euMJknnSSqk\&#34;, title: \&#34;Video One\&#34; },\n  { url: \&#34;https://youtube.com/watch?v=VuivQyVyKDM\&#34;, title: \&#34;Video Two\&#34; },\n  { url: \&#34;https://youtube.com/watch?v=Jc9Eay0tedo\&#34;, title: \&#34;Video Three\&#34; }\n];\n// ============================================================\n\nlet currentVideoList = DEFAULT_VIDEO_LIST;\n\n// Creator settings, editable from the admin panel&#39;s \&#34;Creators\&#34; section and\n// synced the same way the video list is: creatorAliases renames/combines a\n// raw detected author name into a display name (two raw names sharing the\n// same display name become one chip), creatorOrder is the explicit chip\n// order set there, and hiddenCreators removes a raw author from the chin\n// entirely (their videos still show under \&#34;All\&#34;). Declared at this outer\n// script level — not inside either IIFE below — so both the player logic\n// and the admin panel can read and update them directly.\nlet creatorAliases = {};\nlet creatorOrder = [];\nlet hiddenCreators = [];\n\nfunction resolveAuthorDisplay(rawAuthor) {\n  if (!rawAuthor) return rawAuthor;\n  return creatorAliases[rawAuthor] || rawAuthor;\n}\n\nfunction extractVideoId(input) {\n  if (!input) return null;\n  const trimmed = input.trim();\n  if (/^[a-zA-Z0-9_-]{11}$/.test(trimmed)) return trimmed; // already a bare ID\n  const patterns = [\n    /(?:youtube\\.com\\/watch\\?v=|youtube\\.com\\/embed\\/|youtube\\.com\\/shorts\\/|youtu\\.be\\/)([a-zA-Z0-9_-]{11})/\n  ];\n  for (const re of patterns) {\n    const m = trimmed.match(re);\n    if (m) return m[1];\n  }\n  return null;\n}\n\n// previousPlaylist carries over already-resolved title/author data for any\n// video that appears in both the old and new list, by id — instead of\n// wiping every entry back to null and re-fetching from scratch every time\n// this runs. This matters because Firestore&#39;s onSnapshot listener fires\n// more than once on a normal page load (once immediately from its local\n// cache, then again once the server confirms the same data), and without\n// this, that second firing was resetting every author back to null right\n// as the first round&#39;s fetches were finishing — which is what caused the\n// creator chin to get stuck showing \&#34;Loading\&#34; even though the data had\n// already been fetched successfully (a manual click just happened to\n// force a re-render against whichever round&#39;s data had settled by then).\nfunction buildPlaylist(list, previousPlaylist) {\n  const previousById = new Map();\n  (previousPlaylist || []).forEach(v =\u003e { if (v.id) previousById.set(v.id, v); });\n\n  return list\n    .map(v =\u003e {\n      const id = extractVideoId(v.url);\n      if (!id) return null;\n      const prev = previousById.get(id);\n      const manualTitle = (v.title \u0026\u0026 v.title.trim()) ? v.title.trim() : null;\n      return {\n        id,\n        title: manualTitle || (prev ? prev.title : null),\n        author: prev ? prev.author : null\n      };\n    })\n    .filter(Boolean);\n}\n\nlet PLAYLIST = buildPlaylist(currentVideoList);\n\n(function () {\n  const layout = document.getElementById(&#39;layout&#39;);\n  const toggleBtn = document.getElementById(&#39;togglePlaylistBtn&#39;);\n  toggleBtn.addEventListener(&#39;click&#39;, function () {\n    const hidden = layout.classList.toggle(&#39;playlist-hidden&#39;);\n    toggleBtn.textContent = hidden ? &#39;Show Playlist&#39; : &#39;Hide Playlist&#39;;\n    toggleBtn.title = hidden ? &#39;Show playlist&#39; : &#39;Hide playlist&#39;;\n  });\n})();\n\n(function () {\n  const unmuteBtn = document.getElementById(&#39;unmuteBtn&#39;);\n  const playPauseBtn = document.getElementById(&#39;playPauseBtn&#39;);\n  const scrubRange = document.getElementById(&#39;scrubRange&#39;);\n  const timeLabel = document.getElementById(&#39;timeLabel&#39;);\n  const fullscreenBtn = document.getElementById(&#39;fullscreenBtn&#39;);\n  const videoPane = document.getElementById(&#39;videoPane&#39;);\n  const playlistItemsEl = document.getElementById(&#39;playlistItems&#39;);\n  const playlistCountEl = document.getElementById(&#39;playlistCount&#39;);\n  const creatorChinEl = document.getElementById(&#39;creatorChin&#39;);\n  const ytFrame = document.getElementById(&#39;ytFrame&#39;);\n\n  let ytPlayer = null;\n  let isDragging = false;\n  let pollTimer = null;\n  let activeIndex = 0;\n  let activeAuthorFilter = null; // null = \&#34;All\&#34;; a creator&#39;s name filters the list below\n  let apiReady = false;       // true once the YT.Player instance has fired onReady\n  let ytScriptReady = false;  // true once the YouTube iframe API script has loaded\n  let firestoreDataReady = false; // true once the first Firestore snapshot has arrived\n  let pendingLoadId = null;\n\n  unmuteBtn.disabled = true;\n\n  function formatTime(sec) {\n    if (!isFinite(sec) || sec \u003c 0) sec = 0;\n    const m = Math.floor(sec / 60);\n    const s = Math.floor(sec % 60);\n    return m + &#39;:&#39; + (s \u003c 10 ? &#39;0&#39; : &#39;&#39;) + s;\n  }\n\n  function updateRangeFill() {\n    const min = parseFloat(scrubRange.min) || 0;\n    const max = parseFloat(scrubRange.max) || 100;\n    const val = parseFloat(scrubRange.value) || 0;\n    const pct = max \u003e min ? ((val - min) / (max - min)) * 100 : 0;\n    scrubRange.style.background =\n      &#39;linear-gradient(to right, var(--accent) 0%, var(--accent) &#39; + pct +\n      &#39;%, var(--accent-dim) &#39; + pct + &#39;%, var(--accent-dim) 100%)&#39;;\n  }\n\n  function updatePlayPauseIcon(state) {\n    if (state === YT.PlayerState.PLAYING) {\n      playPauseBtn.innerHTML = &#39;\u0026#10074;\u0026#10074;&#39;;\n      playPauseBtn.title = &#39;Pause&#39;;\n    } else {\n      playPauseBtn.innerHTML = &#39;\u0026#9658;&#39;;\n      playPauseBtn.title = &#39;Play&#39;;\n    }\n  }\n\n  function updateProgress() {\n    if (!ytPlayer || isDragging) return;\n    const duration = ytPlayer.getDuration();\n    const current = ytPlayer.getCurrentTime();\n    if (duration \u003e 0) {\n      scrubRange.max = duration;\n      scrubRange.value = current;\n      updateRangeFill();\n      timeLabel.textContent = formatTime(current) + &#39; / &#39; + formatTime(duration);\n    }\n  }\n\n  // ---------- PLAYLIST RENDER ----------\n  // Filtering by creator happens here, over the same PLAYLIST array/data\n  // used everywhere else — data-index still points at the real index in\n  // PLAYLIST (not the filtered array&#39;s position), so clicking a filtered\n  // row still plays the right video and activeIndex stays meaningful.\n  function renderPlaylist() {\n    if (!PLAYLIST.length) {\n      playlistItemsEl.innerHTML = &#39;\u003cdiv class=\&#34;empty-state\&#34;\u003eNo videos added yet.\u003c/div\u003e&#39;;\n      playlistCountEl.textContent = &#39;&#39;;\n      return;\n    }\n\n    const visible = PLAYLIST\n      .map((v, i) =\u003e ({ v, i }))\n      .filter(({ v }) =\u003e !activeAuthorFilter || resolveAuthorDisplay(v.author) === activeAuthorFilter);\n\n    if (!visible.length) {\n      playlistItemsEl.innerHTML = &#39;\u003cdiv class=\&#34;empty-state\&#34;\u003eNo videos from this creator yet.\u003c/div\u003e&#39;;\n      playlistCountEl.textContent = &#39;0 videos&#39;;\n      return;\n    }\n\n    playlistCountEl.textContent = visible.length + (visible.length === 1 ? &#39; video&#39; : &#39; videos&#39;);\n    playlistItemsEl.innerHTML = visible.map(({ v, i }) =\u003e {\n      const title = (typeof v.title === &#39;string&#39; \u0026\u0026 v.title.trim()) ? v.title.trim() : &#39;Loading title…&#39;;\n      // Shows who made it instead of a generic \&#34;Tap to play\&#34; once the\n      // author&#39;s known — falls back to \&#34;Tap to play\&#34; only while it&#39;s\n      // still being fetched.\n      const sub = i === activeIndex\n        ? &#39;Now playing&#39;\n        : (v.author ? escapeHtml(resolveAuthorDisplay(v.author)) : &#39;Tap to play&#39;);\n      return `\n      \u003cbutton class=\&#34;playlist-item${i === activeIndex ? &#39; active&#39; : &#39;&#39;}\&#34; data-index=\&#34;${i}\&#34; title=\&#34;${escapeHtml(title)}\&#34;\u003e\n        \u003cdiv class=\&#34;playlist-thumb-wrap\&#34;\u003e\n          \u003cimg src=\&#34;https://img.youtube.com/vi/${v.id}/mqdefault.jpg\&#34; alt=\&#34;${escapeHtml(title)}\&#34; loading=\&#34;lazy\&#34; /\u003e\n          \u003cspan class=\&#34;now-playing-badge\&#34;\u003eNow Playing\u003c/span\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\&#34;playlist-meta\&#34;\u003e\n          \u003cdiv class=\&#34;playlist-item-title\&#34;\u003e${escapeHtml(title)}\u003c/div\u003e\n          \u003cdiv class=\&#34;playlist-item-sub\&#34;\u003e${sub}\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/button\u003e\n    `;\n    }).join(&#39;&#39;);\n\n    playlistItemsEl.querySelectorAll(&#39;.playlist-item&#39;).forEach(btn =\u003e {\n      btn.addEventListener(&#39;click&#39;, function () {\n        const idx = parseInt(this.getAttribute(&#39;data-index&#39;), 10);\n        playIndex(idx);\n      });\n    });\n  }\n\n  // ---------- CREATOR CHIN RENDER ----------\n  // Auto-populated from whichever authors have shown up on PLAYLIST\n  // entries so far (fetchTitles fills v.author in asynchronously, so this\n  // gets called again each time one resolves). Clicking a chip only\n  // changes the filter used by renderPlaylist above — it never touches\n  // what&#39;s currently playing.\n  //\n  // The \&#34;All\&#34; chip always renders immediately, even before any author has\n  // loaded — a panel that only appears once the network fetch succeeds is\n  // a panel that can silently never appear at all (one failed request and\n  // there&#39;s nothing on screen to show something&#39;s wrong). \&#34;Unknown\&#34; is\n  // kept as a real, clickable chip too instead of being hidden, so a\n  // failed lookup still leaves a working filter rather than making the\n  // whole feature vanish.\n  function renderCreatorChin() {\n    const authors = [];\n    let stillLoading = false;\n    PLAYLIST.forEach(v =\u003e {\n      if (v.author === null) { stillLoading = true; return; }\n      if (hiddenCreators.includes(v.author)) return; // hidden from the chin (its videos still show under \&#34;All\&#34;)\n      const display = resolveAuthorDisplay(v.author);\n      if (!authors.includes(display)) authors.push(display);\n    });\n\n    // Sorted by the admin-set creatorOrder first (from the \&#34;Creators\&#34;\n    // section of the editor); anything not explicitly ordered falls back\n    // to A→Z (case-insensitive) so the chin never looks scrambled just\n    // because a brand-new creator hasn&#39;t been given a position yet.\n    // \&#34;Unknown\&#34; always goes last since it&#39;s a fallback, not a real name.\n    authors.sort((a, b) =\u003e {\n      const ia = creatorOrder.indexOf(a);\n      const ib = creatorOrder.indexOf(b);\n      if (ia !== -1 \u0026\u0026 ib !== -1) return ia - ib;\n      if (ia !== -1) return -1;\n      if (ib !== -1) return 1;\n      if (a === &#39;Unknown&#39;) return 1;\n      if (b === &#39;Unknown&#39;) return -1;\n      return a.localeCompare(b, undefined, { sensitivity: &#39;base&#39; });\n    });\n\n    const allChip = `\u003cbutton class=\&#34;creator-chip${!activeAuthorFilter ? &#39; active&#39; : &#39;&#39;}\&#34; data-author=\&#34;\&#34;\u003eAll\u003c/button\u003e`;\n    const authorChips = authors.map(a =\u003e {\n      const label = a === &#39;Unknown&#39; ? &#39;Unknown Channel&#39; : a;\n      return `\u003cbutton class=\&#34;creator-chip${activeAuthorFilter === a ? &#39; active&#39; : &#39;&#39;}\&#34; data-author=\&#34;${escapeHtml(a)}\&#34;\u003e${escapeHtml(label)}\u003c/button\u003e`;\n    });\n    const loadingChip = stillLoading\n      ? &#39;\u003cspan class=\&#34;creator-chip\&#34; style=\&#34;opacity:0.5;cursor:default;\&#34;\u003eLoading\u003c/span\u003e&#39;\n      : &#39;&#39;;\n    creatorChinEl.innerHTML = [allChip].concat(authorChips).join(&#39;&#39;) + loadingChip;\n\n    creatorChinEl.querySelectorAll(&#39;.creator-chip[data-author]&#39;).forEach(btn =\u003e {\n      btn.addEventListener(&#39;click&#39;, function () {\n        activeAuthorFilter = this.getAttribute(&#39;data-author&#39;) || null;\n        renderCreatorChin();\n        renderPlaylist();\n      });\n    });\n  }\n\n  function escapeHtml(s) {\n    return String(s).replace(/[\u0026\u003c\u003e\&#34;&#39;]/g, c =\u003e ({\n      &#39;\u0026&#39;: &#39;\u0026amp;&#39;, &#39;\u003c&#39;: &#39;\u0026lt;&#39;, &#39;\u003e&#39;: &#39;\u0026gt;&#39;, &#39;\&#34;&#39;: &#39;\u0026quot;&#39;, \&#34;&#39;\&#34;: &#39;\u0026#39;&#39;\n    }[c]));\n  }\n\n  // Pull each video&#39;s real title AND creator name from YouTube&#39;s oEmbed\n  // data (via noembed.com, which mirrors YouTube&#39;s oEmbed response —\n  // including author_name — but reliably sends the CORS headers a\n  // browser needs; calling youtube.com/oembed directly often fails\n  // silently or gets blocked cross-origin). Title-fetching is skipped for\n  // entries where one was typed in manually, but the author is always\n  // pulled since that&#39;s what drives the creator chin.\n  //\n  // This has to live in here (not at the top level of the script) so its\n  // calls to renderPlaylist()/renderCreatorChin() below can actually see\n  // those functions — they&#39;re declared inside this same IIFE. Calling\n  // them from an outer-scope fetchTitles() silently threw a\n  // ReferenceError on every fetch completion (visible only in the\n  // browser console), which is what left the creator chin permanently\n  // stuck showing \&#34;Loading\&#34; even though the author data itself had\n  // already been fetched successfully.\n  function fetchTitles() {\n    PLAYLIST.forEach((v, i) =\u003e {\n      const needsTitle = !v.title;\n      if (!needsTitle \u0026\u0026 v.author) return; // nothing left to fetch for this one\n      const watchUrl = &#39;https://www.youtube.com/watch?v=&#39; + v.id;\n\n      // Some desktop setups (ad blockers, browser extensions, corporate\n      // networks) silently hang a request to a third-party domain like\n      // noembed.com instead of erroring outright — no CORS error, no\n      // rejection, it just never comes back. Aborting after 8s guarantees\n      // this always settles one way or the other.\n      const controller = new AbortController();\n      const timeoutId = setTimeout(() =\u003e controller.abort(), 8000);\n\n      fetch(&#39;https://noembed.com/embed?url=&#39; + encodeURIComponent(watchUrl) + &#39;\u0026format=json&#39;, { signal: controller.signal })\n        .then(res =\u003e { if (!res.ok) throw new Error(&#39;oEmbed request failed&#39;); return res.json(); })\n        .then(data =\u003e {\n          clearTimeout(timeoutId);\n          if (needsTitle) {\n            const t = data \u0026\u0026 typeof data.title === &#39;string&#39; ? data.title.trim() : &#39;&#39;;\n            v.title = t ? t : (&#39;Video &#39; + (i + 1));\n          }\n          const a = data \u0026\u0026 typeof data.author_name === &#39;string&#39; ? data.author_name.trim() : &#39;&#39;;\n          v.author = a || &#39;Unknown&#39;;\n          renderPlaylist();\n          renderCreatorChin();\n        })\n        .catch(() =\u003e {\n          clearTimeout(timeoutId);\n          if (needsTitle) v.title = &#39;Video &#39; + (i + 1);\n          v.author = v.author || &#39;Unknown&#39;;\n          renderPlaylist();\n          renderCreatorChin();\n        });\n    });\n  }\n\n  function playIndex(idx) {\n    if (idx \u003c 0 || idx \u003e= PLAYLIST.length) return;\n    activeIndex = idx;\n    renderPlaylist();\n    const id = PLAYLIST[idx].id;\n    if (ytPlayer \u0026\u0026 apiReady) {\n      ytPlayer.loadVideoById(id);\n    } else {\n      pendingLoadId = id;\n    }\n  }\n\n  // ---------- YT IFRAME API ----------\n  function tryInitPlayer() {\n    if (ytPlayer || !ytScriptReady || !firestoreDataReady || !PLAYLIST.length) return;\n\n    ytFrame.src = &#39;https://www.youtube.com/embed/&#39; + PLAYLIST[0].id +\n      &#39;?rel=0\u0026autoplay=1\u0026mute=1\u0026controls=0\u0026modestbranding=1\u0026iv_load_policy=3\u0026disablekb=1\u0026fs=0\u0026enablejsapi=1&#39;;\n\n    ytPlayer = new YT.Player(&#39;ytFrame&#39;, {\n      events: {\n        onReady: function () {\n          apiReady = true;\n          unmuteBtn.disabled = false;\n          playPauseBtn.disabled = false;\n          scrubRange.disabled = false;\n          updatePlayPauseIcon(YT.PlayerState.PLAYING);\n          updateProgress();\n          if (pollTimer) clearInterval(pollTimer);\n          pollTimer = setInterval(updateProgress, 500);\n          if (pendingLoadId) {\n            ytPlayer.loadVideoById(pendingLoadId);\n            pendingLoadId = null;\n          }\n        },\n        onStateChange: function (event) {\n          updatePlayPauseIcon(event.data);\n          if (event.data === YT.PlayerState.ENDED) {\n            playIndex((activeIndex + 1) % PLAYLIST.length);\n          }\n        }\n      }\n    });\n  }\n\n  window.onYouTubeIframeAPIReady = function () {\n    ytScriptReady = true;\n    tryInitPlayer();\n  };\n\n  unmuteBtn.addEventListener(&#39;click&#39;, function () {\n    if (!ytPlayer || typeof ytPlayer.isMuted !== &#39;function&#39;) return;\n    if (ytPlayer.isMuted()) {\n      ytPlayer.unMute();\n      ytPlayer.setVolume(100);\n      unmuteBtn.textContent = &#39;Mute&#39;;\n      unmuteBtn.title = &#39;Mute&#39;;\n    } else {\n      ytPlayer.mute();\n      unmuteBtn.textContent = &#39;Unmute&#39;;\n      unmuteBtn.title = &#39;Unmute&#39;;\n    }\n  });\n\n  playPauseBtn.addEventListener(&#39;click&#39;, function () {\n    if (!ytPlayer) return;\n    const state = ytPlayer.getPlayerState();\n    if (state === YT.PlayerState.PLAYING) ytPlayer.pauseVideo();\n    else ytPlayer.playVideo();\n  });\n\n  scrubRange.addEventListener(&#39;input&#39;, function () {\n    isDragging = true;\n    updateRangeFill();\n    const duration = ytPlayer ? ytPlayer.getDuration() : parseFloat(scrubRange.max);\n    timeLabel.textContent = formatTime(parseFloat(scrubRange.value)) + &#39; / &#39; + formatTime(duration);\n  });\n\n  scrubRange.addEventListener(&#39;change&#39;, function () {\n    if (ytPlayer) ytPlayer.seekTo(parseFloat(scrubRange.value), true);\n    isDragging = false;\n  });\n\n  // ---------- FULLSCREEN ----------\n  let usingPseudoFullscreen = false;\n\n  function hasNativeFullscreenSupport(el) {\n    return !!(el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen);\n  }\n  function isFullscreen() {\n    return usingPseudoFullscreen || !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);\n  }\n  function requestFs(el) {\n    try {\n      let result;\n      if (el.requestFullscreen) result = el.requestFullscreen();\n      else if (el.webkitRequestFullscreen) result = el.webkitRequestFullscreen();\n      else if (el.mozRequestFullScreen) result = el.mozRequestFullScreen();\n      else if (el.msRequestFullscreen) result = el.msRequestFullscreen();\n      if (result \u0026\u0026 typeof result.catch === &#39;function&#39;) result.catch(() =\u003e enterPseudoFullscreen());\n    } catch (e) { enterPseudoFullscreen(); }\n  }\n  function exitFs() {\n    if (document.exitFullscreen) document.exitFullscreen();\n    else if (document.webkitExitFullscreen) document.webkitExitFullscreen();\n    else if (document.mozCancelFullScreen) document.mozCancelFullScreen();\n    else if (document.msExitFullscreen) document.msExitFullscreen();\n  }\n  function handleEscKey(e) { if (e.key === &#39;Escape&#39; || e.key === &#39;Esc&#39;) exitPseudoFullscreen(); }\n  function enterPseudoFullscreen() {\n    videoPane.classList.add(&#39;pseudo-fullscreen&#39;);\n    usingPseudoFullscreen = true;\n    document.addEventListener(&#39;keydown&#39;, handleEscKey);\n    updateFullscreenIcon();\n  }\n  function exitPseudoFullscreen() {\n    videoPane.classList.remove(&#39;pseudo-fullscreen&#39;);\n    usingPseudoFullscreen = false;\n    document.removeEventListener(&#39;keydown&#39;, handleEscKey);\n    updateFullscreenIcon();\n  }\n  function updateFullscreenIcon() {\n    fullscreenBtn.title = isFullscreen() ? &#39;Exit Fullscreen&#39; : &#39;Fullscreen&#39;;\n  }\n  fullscreenBtn.addEventListener(&#39;click&#39;, function () {\n    if (isFullscreen()) {\n      if (usingPseudoFullscreen) exitPseudoFullscreen();\n      else exitFs();\n      return;\n    }\n    if (hasNativeFullscreenSupport(videoPane)) requestFs(videoPane);\n    else enterPseudoFullscreen();\n  });\n  [&#39;fullscreenchange&#39;, &#39;webkitfullscreenchange&#39;, &#39;mozfullscreenchange&#39;, &#39;MSFullscreenChange&#39;].forEach(evt =\u003e {\n    document.addEventListener(evt, updateFullscreenIcon);\n  });\n\n  // ---------- LIVE SYNC FROM FIRESTORE ----------\n  // Every visitor (no sign-in required) subscribes to the shared playlist\n  // document. The first snapshot boots the player; later snapshots (an\n  // admin saving changes) update the on-screen list for everyone without\n  // a page reload, and try to keep whatever&#39;s currently playing playing.\n  function handlePlaylistSnapshot(list) {\n    currentVideoList = list;\n    const newPlaylist = buildPlaylist(currentVideoList, PLAYLIST);\n\n    if (!firestoreDataReady) {\n      firestoreDataReady = true;\n      PLAYLIST = newPlaylist;\n      activeIndex = 0;\n      renderCreatorChin();\n      renderPlaylist();\n      fetchTitles();\n      tryInitPlayer();\n      return;\n    }\n\n    const currentId = PLAYLIST[activeIndex] ? PLAYLIST[activeIndex].id : null;\n    PLAYLIST = newPlaylist;\n    const stillThereIndex = currentId ? PLAYLIST.findIndex(v =\u003e v.id === currentId) : -1;\n    activeIndex = stillThereIndex \u003e= 0 ? stillThereIndex : 0;\n    // If the creator currently filtered on has no videos left in the\n    // updated list, drop back to \&#34;All\&#34; instead of showing an empty list.\n    if (activeAuthorFilter \u0026\u0026 !PLAYLIST.some(v =\u003e v.author === activeAuthorFilter)) {\n      activeAuthorFilter = null;\n    }\n    renderCreatorChin();\n    renderPlaylist();\n    fetchTitles();\n\n    if (stillThereIndex \u003c 0 \u0026\u0026 PLAYLIST.length) {\n      // The video that was playing got removed from the list — jump to the first one.\n      if (ytPlayer \u0026\u0026 apiReady) ytPlayer.loadVideoById(PLAYLIST[0].id);\n      else pendingLoadId = PLAYLIST[0].id;\n    }\n  }\n\n  PLAYLIST_DOC_REF.onSnapshot(function (doc) {\n    const data = doc.exists ? doc.data() : null;\n    const list = (data \u0026\u0026 Array.isArray(data.videos) \u0026\u0026 data.videos.length) ? data.videos : DEFAULT_VIDEO_LIST;\n    creatorAliases = (data \u0026\u0026 data.creatorAliases \u0026\u0026 typeof data.creatorAliases === &#39;object&#39;) ? data.creatorAliases : {};\n    creatorOrder = (data \u0026\u0026 Array.isArray(data.creatorOrder)) ? data.creatorOrder : [];\n    hiddenCreators = (data \u0026\u0026 Array.isArray(data.hiddenCreators)) ? data.hiddenCreators : [];\n    handlePlaylistSnapshot(list);\n  }, function (err) {\n    console.error(&#39;Playlist sync error:&#39;, err);\n    handlePlaylistSnapshot(DEFAULT_VIDEO_LIST);\n  });\n\n  renderCreatorChin();\n  renderPlaylist();\n})();\n\u003c/script\u003e\n\n\u003cscript\u003e\n// ============================================================\n// ADMIN — hidden sign-in + video list editor.\n//\n// Sign-in is real Firebase Authentication (email/password) — create\n// your admin account once under Firebase console → Authentication →\n// Users → Add user. Writes to the shared playlist are only allowed\n// for signed-in users; enforce that with Firestore security rules\n// (see the note at the bottom of this file for suggested rules).\n// ============================================================\n(function () {\n  const adminTrigger = document.getElementById(&#39;adminTrigger&#39;);\n  const loginOverlay = document.getElementById(&#39;loginOverlay&#39;);\n  const loginClose = document.getElementById(&#39;loginClose&#39;);\n  const loginUser = document.getElementById(&#39;loginUser&#39;);\n  const loginPass = document.getElementById(&#39;loginPass&#39;);\n  const loginSubmit = document.getElementById(&#39;loginSubmit&#39;);\n  const loginError = document.getElementById(&#39;loginError&#39;);\n\n  const adminOverlay = document.getElementById(&#39;adminOverlay&#39;);\n  const adminPanelClose = document.getElementById(&#39;adminPanelClose&#39;);\n  const adminVideoList = document.getElementById(&#39;adminVideoList&#39;);\n  const adminCreatorList = document.getElementById(&#39;adminCreatorList&#39;);\n  const addVideoBtn = document.getElementById(&#39;addVideoBtn&#39;);\n  const saveVideosBtn = document.getElementById(&#39;saveVideosBtn&#39;);\n  const resetDefaultBtn = document.getElementById(&#39;resetDefaultBtn&#39;);\n  const logoutBtn = document.getElementById(&#39;logoutBtn&#39;);\n  const adminSaveStatus = document.getElementById(&#39;adminSaveStatus&#39;);\n\n  let draftList = [];\n  let draftCreators = [];\n\n  function openLogin() {\n    loginError.textContent = &#39;&#39;;\n    loginUser.value = &#39;&#39;;\n    loginPass.value = &#39;&#39;;\n    loginOverlay.hidden = false;\n    loginUser.focus();\n  }\n  function closeLogin() { loginOverlay.hidden = true; }\n\n  // One row per raw creator name PLAYLIST (the live, already-fetched\n  // playlist — a top-level variable shared with the player logic) has\n  // seen an author come back as, plus any raw name already referenced by\n  // saved settings so editing something mid-fetch or briefly absent\n  // doesn&#39;t just disappear from the list.\n  function collectKnownRawAuthors() {\n    const seen = new Set();\n    const list = [];\n    PLAYLIST.forEach(v =\u003e {\n      if (v.author \u0026\u0026 !seen.has(v.author)) { seen.add(v.author); list.push(v.author); }\n    });\n    Object.keys(creatorAliases).forEach(raw =\u003e { if (!seen.has(raw)) { seen.add(raw); list.push(raw); } });\n    hiddenCreators.forEach(raw =\u003e { if (!seen.has(raw)) { seen.add(raw); list.push(raw); } });\n    return list;\n  }\n\n  function buildDraftCreators() {\n    const rows = collectKnownRawAuthors().map(raw =\u003e ({\n      raw,\n      displayAs: creatorAliases[raw] || raw,\n      hidden: hiddenCreators.includes(raw)\n    }));\n    // Pre-sort rows to match the saved creatorOrder (by each row&#39;s current\n    // Display As), so reopening the editor doesn&#39;t visually shuffle\n    // creators that already have an explicit order set.\n    rows.sort((a, b) =\u003e {\n      const ia = creatorOrder.indexOf(a.displayAs);\n      const ib = creatorOrder.indexOf(b.displayAs);\n      if (ia !== -1 \u0026\u0026 ib !== -1) return ia - ib;\n      if (ia !== -1) return -1;\n      if (ib !== -1) return 1;\n      return a.raw.localeCompare(b.raw, undefined, { sensitivity: &#39;base&#39; });\n    });\n    return rows;\n  }\n\n  function renderAdminCreatorList() {\n    if (!draftCreators.length) {\n      adminCreatorList.innerHTML = &#39;\u003cdiv class=\&#34;empty-state\&#34;\u003eNo creators detected yet.\u003c/div\u003e&#39;;\n      return;\n    }\n    adminCreatorList.innerHTML = draftCreators.map((row, i) =\u003e `\n      \u003cdiv class=\&#34;admin-row\&#34; data-index=\&#34;${i}\&#34;\u003e\n        \u003cdiv class=\&#34;admin-row-top\&#34;\u003e\n          \u003cspan class=\&#34;admin-row-title\&#34;\u003e${escapeAttr(row.raw)}\u003c/span\u003e\n          \u003cdiv class=\&#34;admin-row-btns\&#34;\u003e\n            \u003cbutton class=\&#34;round-btn admin-creator-up\&#34; title=\&#34;Move up\&#34; ${i === 0 ? &#39;disabled&#39; : &#39;&#39;}\u003e\u0026uarr;\u003c/button\u003e\n            \u003cbutton class=\&#34;round-btn admin-creator-down\&#34; title=\&#34;Move down\&#34; ${i === draftCreators.length - 1 ? &#39;disabled&#39; : &#39;&#39;}\u003e\u0026darr;\u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003clabel\u003eDisplay As\u003c/label\u003e\n        \u003cinput type=\&#34;text\&#34; class=\&#34;admin-creator-displayas-input\&#34; value=\&#34;${escapeAttr(row.displayAs)}\&#34; /\u003e\n        \u003clabel class=\&#34;admin-checkbox-label\&#34;\u003e\n          \u003cinput type=\&#34;checkbox\&#34; class=\&#34;admin-creator-hide-input\&#34; ${row.hidden ? &#39;checked&#39; : &#39;&#39;} /\u003e\n          Hide from creator filter\n        \u003c/label\u003e\n      \u003c/div\u003e\n    `).join(&#39;&#39;);\n\n    adminCreatorList.querySelectorAll(&#39;.admin-row&#39;).forEach(row =\u003e {\n      const idx = parseInt(row.getAttribute(&#39;data-index&#39;), 10);\n      row.querySelector(&#39;.admin-creator-displayas-input&#39;).addEventListener(&#39;input&#39;, e =\u003e {\n        draftCreators[idx].displayAs = e.target.value;\n      });\n      row.querySelector(&#39;.admin-creator-hide-input&#39;).addEventListener(&#39;change&#39;, e =\u003e {\n        draftCreators[idx].hidden = e.target.checked;\n      });\n      row.querySelector(&#39;.admin-creator-up&#39;).addEventListener(&#39;click&#39;, () =\u003e {\n        if (idx === 0) return;\n        [draftCreators[idx - 1], draftCreators[idx]] = [draftCreators[idx], draftCreators[idx - 1]];\n        renderAdminCreatorList();\n      });\n      row.querySelector(&#39;.admin-creator-down&#39;).addEventListener(&#39;click&#39;, () =\u003e {\n        if (idx === draftCreators.length - 1) return;\n        [draftCreators[idx + 1], draftCreators[idx]] = [draftCreators[idx], draftCreators[idx + 1]];\n        renderAdminCreatorList();\n      });\n    });\n  }\n\n  function openAdminPanel() {\n    draftList = currentVideoList.map(v =\u003e ({ url: v.url, title: v.title || &#39;&#39; }));\n    draftCreators = buildDraftCreators();\n    renderAdminList();\n    renderAdminCreatorList();\n    adminSaveStatus.textContent = &#39;&#39;;\n    adminOverlay.hidden = false;\n  }\n  function closeAdminPanel() { adminOverlay.hidden = true; }\n\n  adminTrigger.addEventListener(&#39;click&#39;, function () {\n    if (auth.currentUser) openAdminPanel();\n    else openLogin();\n  });\n  document.addEventListener(&#39;keydown&#39;, function (e) {\n    if (e.ctrlKey \u0026\u0026 e.altKey \u0026\u0026 (e.key === &#39;a&#39; || e.key === &#39;A&#39;)) {\n      if (auth.currentUser) openAdminPanel();\n      else openLogin();\n    }\n  });\n\n  loginClose.addEventListener(&#39;click&#39;, closeLogin);\n  loginOverlay.addEventListener(&#39;click&#39;, function (e) { if (e.target === loginOverlay) closeLogin(); });\n\n  async function handleLoginSubmit() {\n    const email = loginUser.value.trim();\n    const pass = loginPass.value;\n    if (!email || !pass) {\n      loginError.textContent = &#39;Enter an email and password.&#39;;\n      return;\n    }\n    loginSubmit.disabled = true;\n    loginSubmit.textContent = &#39;Checking\\u2026&#39;;\n    try {\n      await auth.signInWithEmailAndPassword(email, pass);\n      closeLogin();\n      openAdminPanel();\n    } catch (err) {\n      loginError.textContent = &#39;Sign-in failed: &#39; + (err \u0026\u0026 err.message ? err.message : &#39;unknown error&#39;);\n    } finally {\n      loginSubmit.disabled = false;\n      loginSubmit.textContent = &#39;Sign In&#39;;\n    }\n  }\n  loginSubmit.addEventListener(&#39;click&#39;, handleLoginSubmit);\n  loginPass.addEventListener(&#39;keydown&#39;, function (e) { if (e.key === &#39;Enter&#39;) handleLoginSubmit(); });\n\n  adminPanelClose.addEventListener(&#39;click&#39;, closeAdminPanel);\n  adminOverlay.addEventListener(&#39;click&#39;, function (e) { if (e.target === adminOverlay) closeAdminPanel(); });\n  logoutBtn.addEventListener(&#39;click&#39;, function () {\n    auth.signOut();\n    closeAdminPanel();\n  });\n\n  function renderAdminList() {\n    if (!draftList.length) {\n      adminVideoList.innerHTML = &#39;\u003cdiv class=\&#34;empty-state\&#34;\u003eNo videos yet. Add one below.\u003c/div\u003e&#39;;\n      return;\n    }\n    adminVideoList.innerHTML = draftList.map((v, i) =\u003e `\n      \u003cdiv class=\&#34;admin-row\&#34; data-index=\&#34;${i}\&#34;\u003e\n        \u003cdiv class=\&#34;admin-row-top\&#34;\u003e\n          \u003cspan class=\&#34;admin-row-title\&#34;\u003eVideo ${i + 1}\u003c/span\u003e\n          \u003cdiv class=\&#34;admin-row-btns\&#34;\u003e\n            \u003cbutton class=\&#34;round-btn admin-move-up\&#34; title=\&#34;Move up\&#34; ${i === 0 ? &#39;disabled&#39; : &#39;&#39;}\u003e\u0026uarr;\u003c/button\u003e\n            \u003cbutton class=\&#34;round-btn admin-move-down\&#34; title=\&#34;Move down\&#34; ${i === draftList.length - 1 ? &#39;disabled&#39; : &#39;&#39;}\u003e\u0026darr;\u003c/button\u003e\n            \u003cbutton class=\&#34;round-btn admin-remove\&#34; title=\&#34;Remove\&#34;\u003e\u0026times;\u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003clabel\u003eYouTube Link\u003c/label\u003e\n        \u003cinput type=\&#34;text\&#34; class=\&#34;admin-url-input\&#34; placeholder=\&#34;Paste a YouTube link\&#34; value=\&#34;${escapeAttr(v.url)}\&#34; /\u003e\n        \u003clabel\u003eTitle\u003c/label\u003e\n        \u003cinput type=\&#34;text\&#34; class=\&#34;admin-title-input\&#34; placeholder=\&#34;Video title\&#34; value=\&#34;${escapeAttr(v.title)}\&#34; /\u003e\n      \u003c/div\u003e\n    `).join(&#39;&#39;);\n\n    adminVideoList.querySelectorAll(&#39;.admin-row&#39;).forEach(row =\u003e {\n      const idx = parseInt(row.getAttribute(&#39;data-index&#39;), 10);\n      row.querySelector(&#39;.admin-url-input&#39;).addEventListener(&#39;input&#39;, e =\u003e { draftList[idx].url = e.target.value; });\n      row.querySelector(&#39;.admin-title-input&#39;).addEventListener(&#39;input&#39;, e =\u003e { draftList[idx].title = e.target.value; });\n      row.querySelector(&#39;.admin-remove&#39;).addEventListener(&#39;click&#39;, () =\u003e {\n        draftList.splice(idx, 1);\n        renderAdminList();\n      });\n      row.querySelector(&#39;.admin-move-up&#39;).addEventListener(&#39;click&#39;, () =\u003e {\n        if (idx === 0) return;\n        [draftList[idx - 1], draftList[idx]] = [draftList[idx], draftList[idx - 1]];\n        renderAdminList();\n      });\n      row.querySelector(&#39;.admin-move-down&#39;).addEventListener(&#39;click&#39;, () =\u003e {\n        if (idx === draftList.length - 1) return;\n        [draftList[idx + 1], draftList[idx]] = [draftList[idx], draftList[idx + 1]];\n        renderAdminList();\n      });\n    });\n  }\n\n  function escapeAttr(s) {\n    return String(s || &#39;&#39;).replace(/[\u0026\u003c\u003e\&#34;&#39;]/g, c =\u003e ({\n      &#39;\u0026&#39;: &#39;\u0026amp;&#39;, &#39;\u003c&#39;: &#39;\u0026lt;&#39;, &#39;\u003e&#39;: &#39;\u0026gt;&#39;, &#39;\&#34;&#39;: &#39;\u0026quot;&#39;, \&#34;&#39;\&#34;: &#39;\u0026#39;&#39;\n    }[c]));\n  }\n\n  addVideoBtn.addEventListener(&#39;click&#39;, function () {\n    // New entries go to the front so a freshly added video plays first,\n    // not last.\n    draftList.unshift({ url: &#39;&#39;, title: &#39;&#39; });\n    renderAdminList();\n  });\n\n  saveVideosBtn.addEventListener(&#39;click&#39;, async function () {\n    const cleaned = draftList\n      .map(v =\u003e ({ url: (v.url || &#39;&#39;).trim(), title: (v.title || &#39;&#39;).trim() }))\n      .filter(v =\u003e v.url);\n\n    const invalid = cleaned.filter(v =\u003e !extractVideoId(v.url));\n    if (invalid.length) {\n      adminSaveStatus.style.color = &#39;#ff9b9b&#39;;\n      adminSaveStatus.textContent = &#39;One or more links don\\u2019t look like valid YouTube links — fix those and save again.&#39;;\n      return;\n    }\n\n    if (!auth.currentUser) {\n      adminSaveStatus.style.color = &#39;#ff9b9b&#39;;\n      adminSaveStatus.textContent = &#39;You\\u2019ve been signed out — please sign in again.&#39;;\n      return;\n    }\n\n    // Turn the Creators rows into the three fields the player reads:\n    // aliases for any row renamed away from its raw detected name (giving\n    // two rows the same Display As combines them), hiddenCreators for any\n    // row checked \&#34;Hide,\&#34; and creatorOrder as the surviving (non-hidden)\n    // Display As values in their current row order, deduped so a combined\n    // pair only claims one slot.\n    const creatorAliasesToSave = {};\n    const creatorOrderToSave = [];\n    const hiddenCreatorsToSave = [];\n    draftCreators.forEach(row =\u003e {\n      const display = (row.displayAs || &#39;&#39;).trim() || row.raw;\n      if (display !== row.raw) creatorAliasesToSave[row.raw] = display;\n      if (row.hidden) {\n        hiddenCreatorsToSave.push(row.raw);\n      } else if (!creatorOrderToSave.includes(display)) {\n        creatorOrderToSave.push(display);\n      }\n    });\n\n    saveVideosBtn.disabled = true;\n    adminSaveStatus.style.color = &#39;var(--accent)&#39;;\n    adminSaveStatus.textContent = &#39;Saving\\u2026&#39;;\n    try {\n      await PLAYLIST_DOC_REF.set({\n        videos: cleaned,\n        creatorAliases: creatorAliasesToSave,\n        creatorOrder: creatorOrderToSave,\n        hiddenCreators: hiddenCreatorsToSave,\n        updatedAt: firebase.firestore.FieldValue.serverTimestamp(),\n        updatedBy: auth.currentUser.email || auth.currentUser.uid\n      });\n      // No need to update local state manually — the onSnapshot listener\n      // above will pick this up and refresh the player/playlist for\n      // everyone, including this browser.\n      adminSaveStatus.style.color = &#39;var(--accent)&#39;;\n      adminSaveStatus.textContent = &#39;Saved — everyone will see the update.&#39;;\n    } catch (err) {\n      adminSaveStatus.style.color = &#39;#ff9b9b&#39;;\n      adminSaveStatus.textContent = &#39;Save failed: &#39; + (err \u0026\u0026 err.message ? err.message : &#39;unknown error&#39;) + &#39; (check your Firestore security rules).&#39;;\n    } finally {\n      saveVideosBtn.disabled = false;\n    }\n  });\n\n  resetDefaultBtn.addEventListener(&#39;click&#39;, function () {\n    draftList = DEFAULT_VIDEO_LIST.map(v =\u003e ({ url: v.url, title: v.title || &#39;&#39; }));\n    renderAdminList();\n    adminSaveStatus.style.color = &#39;var(--accent)&#39;;\n    adminSaveStatus.textContent = &#39;Reset to default list \\u2014 click Save Changes to apply.&#39;;\n  });\n})();\n\u003c/script\u003e\n\n\u003c!-- YouTube IFrame Player API --\u003e\n\u003cscript src=\&#34;https://www.youtube.com/iframe_api\&#34;\u003e\u003c/script\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n&#34;},&#34;contentType&#34;:&#34;block&#34;},&#34;size&#34;:{&#34;width&#34;:8,&#34;height&#34;:16}}],&#34;overflow&#34;:&#34;scroll&#34;},&#34;themeCategory&#34;:&#34;grid&#34;,&#34;actions&#34;:{},&#34;id&#34;:&#34;91A24679-7D41-4884-8409-342DBF774E39&#34;},&#34;title&#34;:&#34;Videos&#34;,&#34;route&#34;:&#34;/videos&#34;}},&#34;explore&#34;:false,&#34;host&#34;:&#34;knobsock.net&#34;,&#34;isSnapshot&#34;:false,&#34;userAgent&#34;:&#34;Mozilla/5.0 (compatible; View Page Source/2.9; +https://www.view-page-source.com/)&#34;}},&#34;__N_SSP&#34;:true},&#34;page&#34;:&#34;/_sites/[siteId]/pages/[pageId]/[cacheTag]&#34;,&#34;query&#34;:{&#34;siteId&#34;:&#34;2476929&#34;,&#34;pageId&#34;:&#34;8807491&#34;,&#34;cacheTag&#34;:&#34;2026-08-31T08:32:20.411Z&#34;},&#34;buildId&#34;:&#34;FNXPbpUIGNmu9BSL3Zn3o&#34;,&#34;isFallback&#34;:false,&#34;isExperimentalCompile&#34;:false,&#34;gssp&#34;:true,&#34;scriptLoader&#34;:[]}
    </script>
  </body>
